EXPO_PUBLIC_STREAM_VIDEO_API_KEY=your_stream_video_api_key
EXPO_PUBLIC_BACKEND_URL_DEVICE=https://api.example.com
#EXPO_PUBLIC_BACKEND_URL_DEVICE=http://192.168.1.100:4000
EXPO_PUBLIC_BACKEND_URL_ANDROID_EMULATOR=http://10.0.2.2:4000

# Google Maps key used from JavaScript (Directions API, route rendering).
# The native Maps SDK reads its own copy from app.json / AndroidManifest —
# rotating the key means updating both. Restrict it to the Android package
# name and release SHA-1 in Google Cloud Console.
EXPO_PUBLIC_DIRECTIONS_API_KEY=your_google_maps_api_key

# DPO/PayGate merchant credentials are NOT set here. Anything prefixed with
# EXPO_PUBLIC_ is inlined into the shipped JS bundle and can be read out of the
# APK. They live on the backend as DPO_PAYGATE_ID / DPO_ENCRYPTION_KEY.
