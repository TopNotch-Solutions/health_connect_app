EXPO_PUBLIC_BACKEND_URL_DEVICE=https://api.example.com
#EXPO_PUBLIC_BACKEND_URL_DEVICE=http://192.168.1.100:4000
EXPO_PUBLIC_BACKEND_URL_ANDROID_EMULATOR=http://10.0.2.2:4000

# DPO/PayGate merchant credentials are NOT set here. Anything prefixed with
