EXPO_PUBLIC_STREAM_VIDEO_API_KEY=your_stream_video_api_key
EXPO_PUBLIC_BACKEND_URL_DEVICE=https://api.example.com
#EXPO_PUBLIC_BACKEND_URL_DEVICE=http://192.168.1.100:4000
EXPO_PUBLIC_BACKEND_URL_ANDROID_EMULATOR=http://10.0.2.2:4000

# --- Google Maps ---
# Three separate concerns; use three separate keys with different restrictions.
#
# 1. Directions API, called from JavaScript (lib/googleMaps.ts).
#    Ships in the JS bundle. It CANNOT be restricted by Android package name,
#    because these are plain HTTPS calls that carry no app attestation — an
#    app-restricted key returns REQUEST_DENIED here. Restrict it by API
#    (Directions only) and set a quota cap. Better still, proxy these calls
#    through the backend so the key leaves the app entirely.
EXPO_PUBLIC_DIRECTIONS_API_KEY=your_directions_api_key

# 2. Maps SDK for Android — native map rendering. Read at build time by
#    app.config.js, NOT inlined into the JS bundle (hence no EXPO_PUBLIC_
#    prefix). Restrict by package name + release SHA-1, and to Maps SDK only.
GOOGLE_MAPS_ANDROID_KEY=your_android_maps_sdk_key

# 3. Maps SDK for iOS. Restrict by bundle identifier.
#    If unset, app.config.js falls back to the Android key so maps still
#    render — set a proper one before shipping iOS.
GOOGLE_MAPS_IOS_KEY=your_ios_maps_sdk_key
#
# For EAS cloud builds, .env is not uploaded — add 2 and 3 as EAS secrets:
#   eas secret:create --name GOOGLE_MAPS_ANDROID_KEY --value <key>

# DPO/PayGate merchant credentials are NOT set here. Anything prefixed with
# EXPO_PUBLIC_ is inlined into the shipped JS bundle and can be read out of the
# APK. They live on the backend as DPO_PAYGATE_ID / DPO_ENCRYPTION_KEY.
